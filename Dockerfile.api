FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create a venv for the app (keeps image tidy and predictable)
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# CPU-only torch: avoids gigantic CUDA/cuDNN deps that can exhaust VM disk during Docker build.
# We pin to the same torch major/minor implied by your environment; update if you bump sentence-transformers/torch.
RUN pip install --upgrade pip && \
    pip install --extra-index-url https://download.pytorch.org/whl/cpu "torch==2.9.1+cpu"

# Install the app + dependencies (from pyproject.toml)
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN pip install .

EXPOSE 8000

CMD ["python","-m","uvicorn","expense_manager.components.ai_chabot.app:app","--host","0.0.0.0","--port","8000","--app-dir","src"]
